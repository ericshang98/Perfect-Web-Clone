// App.jsx.template — REFERENCE shape of the file that
// `mcp_server/tools/build_deploy.py::assemble_project` writes into the sandbox.
//
// IMPORTANT: this file is documentation, NOT a runtime template. assemble_project
// renders src/App.jsx in pure Python (`_render_app_jsx`) and does NOT read this
// file. It lives here so a human (or Claude Code) can see, at a glance, the exact
// output contract assembly produces — keep the two in sync if either changes.
//
// Placeholders below use {{...}} to mark the deterministic substitutions that
// `_render_app_jsx` fills from the section_analyzer's assembly_template:
//   {{page_title}}   -> template["page_title"]
//   {{source_url}}   -> template["source_url"]
//   {{section_count}}-> len(component_order)
//   {{imports}}      -> one `import <ImportName> from "<import_path>";` per section,
//                       in ascending `order`, deduped by import_name.
//   {{renders}}      -> one `<ImportName />` per section, same order, inside a
//                       single root fragment (top -> bottom == the route).
//
// Section subagents must NOT write this file; it is a shared / assembly-owned
// file. Re-run assemble_project() to regenerate it.

// App.jsx — GENERATED by assemble_project(). Do not edit by hand;
// re-run assemble_project() to regenerate. Section subagents must not
// touch this file (it is a shared/assembly-owned file).
// page_title: {{page_title}}
// source_url: {{source_url}}
// sections: {{section_count}}

{{imports}}

export default function App() {
  return (
    <>
{{renders}}
    </>
  );
}

